#!/bin/sh

if [ "$1" = "stop" ]
then
    echo Unmounting filesystems
    umount -a -r
    mount -n -o remount -r %root% /
    swapoff -a
fi

if [ "$1" = "start" ]
then
    echo Mounting filesystems
    # /proc is mounted by the mount-proc-sys script
    # mount -n -t proc  proc  /proc
    mount -n -t $TMPFS rwfs  /mnt/rwfs -o size=1024k
    if [ "$READONLY_FS" != "y" ]
    then
        mount -n -o remount -w %root% /
    else
        RAMDIRS="$RAMDIRS /tmp /etc /var"
    fi
    if [ -n "$RAMDIRS" ]
    then
        for i in $RAMDIRS
        do
            if [ ! -e /mnt/rwfs/$i ]
            then
                cp -a $i /mnt/rwfs/
                mount -n -o bind /mnt/rwfs/$i $i
            fi
        done
    fi
    if [ "$TMPFS" = "tmpfs" ]
    then
        mount -n -t $TMPFS shm /dev/shm
    fi
    if [ ! -e /etc/mtab ]
    then
        ln -s /proc/mounts /etc/mtab
    fi
    mount -n -a
fi
